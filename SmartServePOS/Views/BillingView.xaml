<Page
	x:Class="SmartServePOS.Views.BillingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	Background="#ECECEC"
	mc:Ignorable="d">


	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="48" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ================= TOP BAR =================  -->
		<Grid Grid.Row="0" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
				Height="36"
				Padding="8"
				BorderBrush="#CCCCCC"
				FontSize="14"
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

			<StackPanel
				Grid.Column="1"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Width="90"
					Margin="10,4,4,4"
					Background="#C62828"
					Content="Dine In"
					Cursor="Hand"
					Foreground="White" />
				<!--<Button
					Width="90"
					Margin="4"
					Background="#555"
					Content="Delivery"
					Cursor="Hand"
					Foreground="White" />
				<Button
					Width="90"
					Margin="4"
					Background="#555"
					Content="Pick Up"
					Cursor="Hand"
					Foreground="White" />
				-->
				<Button
					Width="90"
					Margin="4"
					Background="#555"
					Command="{Binding ReloadMenuCommand}"
					Content="Refresh"
					Cursor="Hand"
					Foreground="White" />
			</StackPanel>
		</Grid>

		<!--  ================= MAIN =================  -->
		<Grid Grid.Row="1" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="180" />
				<!--  Categories  -->
				<ColumnDefinition Width="340" />
				<!--  Products  -->
				<ColumnDefinition Width="220" />
				<!--  Variants  -->
				<ColumnDefinition Width="*" />
				<!--  Bill  -->
			</Grid.ColumnDefinitions>

			<!--  ================= CATEGORIES =================  -->

			<Border
				Grid.Column="0"
				Padding="6"
				Background="#262626"
				CornerRadius="6"
				IsHitTestVisible="{Binding IsSearchActive, Converter={StaticResource BoolToHitTestConverter}}"
				Opacity="{Binding IsSearchActive, Converter={StaticResource BoolToOpacityConverter}}">


				<ListBox
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Categories}"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding SelectedCategory}">

					<!--  Remove default selection visuals  -->
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="2" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								x:Name="Root"
								Height="46"
								Background="#333333"
								CornerRadius="6"
								Cursor="Hand">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<!--  Accent Bar  -->
									<Border
										x:Name="Accent"
										Grid.Column="0"
										Background="#C62828"
										CornerRadius="6,0,0,6"
										Visibility="Collapsed" />

									<!--  Text  -->
									<TextBlock
										Grid.Column="1"
										Margin="12,0"
										VerticalAlignment="Center"
										FontSize="15"
										FontWeight="SemiBold"
										Foreground="White"
										Text="{Binding Name}" />
								</Grid>
							</Border>

							<!--  STATES  -->
							<DataTemplate.Triggers>

								<!--  Selected  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#3E3E3E" />
									<Setter TargetName="Accent" Property="Visibility" Value="Visible" />
								</DataTrigger>

								<!--  Hover  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#444444" />
								</DataTrigger>

							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<!--  ================= PRODUCTS =================  -->
			<Border
				Grid.Column="1"
				Padding="2"
				Background="#F2F2F2"
				CornerRadius="6"
				IsHitTestVisible="{Binding IsSearchActive, Converter={StaticResource BoolToHitTestConverter}}"
				Opacity="{Binding IsSearchActive, Converter={StaticResource BoolToOpacityConverter}}">

				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

					<ListBox
						Background="Transparent"
						BorderThickness="0"
						ItemsSource="{Binding Products}"
						SelectedItem="{Binding SelectedProduct}">

						<!--  Dense vertical layout  -->
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="2" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>

						<!--  Remove default ListBox styling  -->
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="0" />
								<Setter Property="Margin" Value="6" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								<Setter Property="VerticalContentAlignment" Value="Stretch" />
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderThickness" Value="0" />
							</Style>
						</ListBox.ItemContainerStyle>

						<!--  PRODUCT CARD  -->
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border
									x:Name="Root"
									Height="40"
									Padding="2"
									Background="White"
									BorderBrush="#DADADA"
									BorderThickness="1"
									CornerRadius="6">

									<TextBlock
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Text="{Binding Name}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</Border>

								<!--  STATES  -->
								<DataTemplate.Triggers>

									<!--  Selected  -->
									<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
										<Setter TargetName="Root" Property="Background" Value="#FFF3E0" />
										<Setter TargetName="Root" Property="BorderBrush" Value="#C62828" />
										<Setter TargetName="Root" Property="BorderThickness" Value="2" />
									</DataTrigger>

									<!--  Hover  -->
									<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
										<Setter TargetName="Root" Property="Background" Value="#FAFAFA" />
									</DataTrigger>

								</DataTemplate.Triggers>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>
				</ScrollViewer>
			</Border>

			<!--  ================= VARIANT PANEL =================  -->
			<Border
				Grid.Column="2"
				Padding="6"
				Background="#FAFAFA"
				CornerRadius="6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  Product Name  -->
					<TextBlock
						Margin="4,2,4,6"
						FontSize="12"
						FontWeight="Bold"
						Text="{Binding SelectedProduct.Name}" />

					<!--  Variant List  -->
					<ScrollViewer
						Grid.Row="1"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">

						<ItemsControl ItemsSource="{Binding Variants}">

							<!--  🔑 REQUIRED: Stretch item container  -->
							<ItemsControl.ItemContainerStyle>
								<Style TargetType="ContentPresenter">
									<Setter Property="HorizontalAlignment" Value="Stretch" />
								</Style>
							</ItemsControl.ItemContainerStyle>

							<!--  Panel  -->
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<!--  Item Template  -->
							<ItemsControl.ItemTemplate>
								<DataTemplate>

									<Button
										MinHeight="46"
										Margin="5"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Stretch"
										Background="White"
										BorderBrush="#C62828"
										BorderThickness="1"
										Command="{Binding DataContext.AddVariantCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
										CommandParameter="{Binding}">

										<!--  ONE ROW GRID  -->
										<Grid Margin="12,6">
											<Grid.ColumnDefinitions>
												<!--  Name takes all remaining space  -->
												<ColumnDefinition Width="*" />
												<!--  Price auto-sized but pushed right  -->
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<!--  Variant Name  -->
											<TextBlock
												VerticalAlignment="Center"
												FontSize="16"
												FontWeight="SemiBold"
												Text="{Binding VariantName}"
												TextTrimming="CharacterEllipsis" />

											<!--  Price (EXTREME RIGHT)  -->
											<TextBlock
												Grid.Column="1"
												Margin="16,0,0,0"
												VerticalAlignment="Center"
												FontSize="16"
												FontWeight="Bold"
												Foreground="#2E7D32"
												Text="{Binding Price, StringFormat=₹ {0:N0}}" />
										</Grid>
									</Button>

								</DataTemplate>
							</ItemsControl.ItemTemplate>

						</ItemsControl>
					</ScrollViewer>

				</Grid>
			</Border>


			<!--  ================= BILL PANEL =================  -->
			<Border
				Grid.Column="3"
				Padding="8"
				Background="White"
				CornerRadius="6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Header  -->
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="20" />
							<!--  Remove  -->
							<ColumnDefinition Width="180" />
							<!--  Item  -->
							<ColumnDefinition Width="110" />
							<!--  Qty  -->
							<ColumnDefinition Width="90" />
							<!--  Price  -->
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="1"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="ITEMS" />

						<TextBlock
							Grid.Column="2"
							HorizontalAlignment="Center"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="QTY." />

						<TextBlock
							Grid.Column="3"
							HorizontalAlignment="Right"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="PRICE" />
					</Grid>


					<!--  Bill Items  -->
					<ItemsControl
						Grid.Row="1"
						Margin="0,6,0,0"
						ItemsSource="{Binding BillItems}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Padding="2"
									BorderBrush="#E6E6E6"
									BorderThickness="1"
									CornerRadius="6">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="180" />
											<ColumnDefinition Width="110" />
											<ColumnDefinition Width="90" />
										</Grid.ColumnDefinitions>
										<!--  REMOVE  -->
										<Button
											Grid.Column="0"
											Width="24"
											Height="24"
											Padding="5"
											Background="Transparent"
											BorderThickness="0"
											Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
											CommandParameter="{Binding}"
											Content="✕"
											Cursor="Hand"
											Foreground="Red" />
										<!--  ITEM  -->
										<StackPanel Grid.Column="1">
											<TextBlock
												FontSize="13"
												FontWeight="SemiBold"
												Text="{Binding ItemName}"
												TextWrapping="Wrap" />
											<TextBlock
												FontSize="11"
												Foreground="#888"
												Text="{Binding PriceSnapshot, StringFormat=₹{0} each}" />
										</StackPanel>
										<!--  QTY  -->
										<Border
											Grid.Column="2"
											Padding="2"
											HorizontalAlignment="Center"
											BorderBrush="#DDD"
											BorderThickness="1"
											CornerRadius="4">

											<StackPanel Orientation="Horizontal">
												<Button
													Width="26"
													Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="−"
													Cursor="Hand" />

												<TextBlock
													Width="26"
													VerticalAlignment="Center"
													FontWeight="Bold"
													Text="{Binding Quantity}"
													TextAlignment="Center" />

												<Button
													Width="26"
													Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="+"
													Cursor="Hand" />
											</StackPanel>
										</Border>
										<!--  PRICE  -->
										<StackPanel
											Grid.Column="3"
											HorizontalAlignment="Right"
											VerticalAlignment="Center">
											<TextBlock
												FontSize="14"
												FontWeight="Bold"
												Text="{Binding TotalPrice, StringFormat=₹{0}}" />
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Border
						Grid.Row="2"
						Padding="10"
						Background="#2E2E2E">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="180" />
							</Grid.ColumnDefinitions>

							<StackPanel Orientation="Horizontal">
								<Button
									Width="90"
									Margin="4"
									Background="#C62828"
									Command="{Binding SaveCommand}"
									Content="Save"
									Foreground="White"
									IsEnabled="{Binding IsEditable}" />
								<!--<Button
									Width="90"
									Margin="4"
									Background="#444"
									Command="{Binding PrintCommand}"
									Content="Print"
									Foreground="White" />-->
							</StackPanel>

							<StackPanel Grid.Column="1" HorizontalAlignment="Right">
								<TextBlock
									HorizontalAlignment="Right"
									FontSize="12"
									Foreground="White"
									Text="TOTAL" />
								<TextBlock
									HorizontalAlignment="Right"
									FontSize="30"
									FontWeight="Bold"
									Foreground="Yellow"
									Text="{Binding GrandTotal, StringFormat=₹{0}}" />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Page>
