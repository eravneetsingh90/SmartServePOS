<Page x:Class="SmartServePOS.Views.BillingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:BillingViewModel}"
      mc:Ignorable="d"
      Background="#F1F1F1">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="52"/>
			<RowDefinition Height="*"/>
			
		</Grid.RowDefinitions>

		<!-- ================= TOP SEARCH ================= -->
		<Grid Grid.Row="0" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="360"/>
			</Grid.ColumnDefinitions>

			<TextBox Height="38"
                     Padding="10"
                     FontSize="14"
                     BorderBrush="#CCCCCC"/>
			<!--PlaceholderText="Search item"/>-->

			<!-- Order Type -->
			<Grid Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

				<Button Content="Dine In"
                        Background="#C62828"
                        Foreground="White"
                        FontWeight="Bold"/>

				<Button Grid.Column="1"
                        Content="Delivery"
                        Background="#3E3E3E"
                        Foreground="White"/>

				<Button Grid.Column="2"
                        Content="Pick Up"
                        Background="#3E3E3E"
                        Foreground="White"/>
			</Grid>
		</Grid>

		<!-- ================= MAIN ================= -->
		<Grid Grid.Row="1" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="420"/>
			</Grid.ColumnDefinitions>

			<!-- ===== CATEGORIES (Pure XAML, POS Style) ===== -->
			<Border Background="#3F3F3F"
        CornerRadius="6"
        Padding="8">

				<ListBox ItemsSource="{Binding Categories}"
         SelectedItem="{Binding SelectedCategory}"
         BorderThickness="0"
         Background="Transparent"
         ScrollViewer.VerticalScrollBarVisibility="Auto">

    <!-- ITEM CONTAINER STYLE -->
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid Height="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Accent Bar -->
                                <Border x:Name="AccentBar"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        CornerRadius="4,0,0,4"/>
                                <!-- Category Button -->
                                <Border x:Name="CategoryCard"
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Background="#5A5A5A"
                                        CornerRadius="6"
                                        Padding="14,10">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="#C62828"/>
                                <Setter TargetName="CategoryCard" Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryCard" Property="Background" Value="#666666"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>

    <!-- ITEM TEMPLATE -->
    <ListBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>
			</Border>


			<!-- ===== ITEMS GRID ===== -->
			<ScrollViewer Grid.Column="1">
				<ItemsControl ItemsSource="{Binding Products}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemWidth="190" ItemHeight="95"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="6"
                                    Padding="10"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4">
								<StackPanel>
									<TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
									<TextBlock Text="{Binding Price, StringFormat=₹{0}}"
                                               Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!-- ===== BILL PANEL ===== -->
			<Border Grid.Column="2"
                    Background="White"
                    CornerRadius="6"
                    Padding="10">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Header -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition Width="60"/>
							<ColumnDefinition Width="80"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="ITEMS" FontWeight="Bold"/>
						<TextBlock Grid.Column="1" Text="QTY"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
						<TextBlock Grid.Column="2" Text="PRICE"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
					</Grid>

					<!-- Bill Items -->
					<ListView Grid.Row="1"
                              ItemsSource="{Binding BillItems}"
                              BorderThickness="0"
                              Margin="0,6,0,0">
						<ListView.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition/>
										<ColumnDefinition Width="60"/>
										<ColumnDefinition Width="80"/>
									</Grid.ColumnDefinitions>

									<TextBlock Text="{Binding ItemName}"/>

									<TextBlock Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               HorizontalAlignment="Center"/>

									<TextBlock Grid.Column="2"
                                               Text="{Binding TotalPrice}"
                                               HorizontalAlignment="Right"/>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>

					<Border Grid.Row="2"
        Background="#2E2E2E"
        Padding="12">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition Width="260"/>
							</Grid.ColumnDefinitions>

							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
									<RadioButton Content="Cash" Foreground="White" IsChecked="True" Margin="8,0"/>
									<RadioButton Content="Card" Foreground="White" Margin="8,0"/>
									<RadioButton Content="UPI" Foreground="White" Margin="8,0"/>
									<RadioButton Content="Due" Foreground="White" Margin="8,0"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal">
									<Button Content="Save"
                        Width="100"
                        Margin="4"
                        Background="#C62828"
                        Foreground="White"/>

									<Button Content="Save &amp; Print"
                        Width="140"
                        Margin="4"
                        Background="#C62828"
                        Foreground="White"/>

									<Button Content="KOT"
                        Width="90"
                        Margin="4"
                        Background="#444"
                        Foreground="White"/>
								</StackPanel>
							</StackPanel>

							<!-- TOTAL -->
							<StackPanel Grid.Column="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">
								<TextBlock Text="TOTAL"
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Right"/>
								<TextBlock Text="{Binding GrandTotal}"
                       Foreground="Yellow"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Grid>

	</Grid>
</Page>
