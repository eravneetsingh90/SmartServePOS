<Page x:Class="SmartServePOS.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			  xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels" 
			  d:DataContext="{d:DesignInstance Type=viewmodels:BillingViewModel}"
			  mc:Ignorable="d"
             Background="#F5F5F5">

	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="140"/>
		</Grid.RowDefinitions>

		<!-- ================= BILL ITEMS ================= -->
		<Border Background="White" CornerRadius="6" Padding="10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="40"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Header -->
				<Grid Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="80"/>
						<ColumnDefinition Width="100"/>
					</Grid.ColumnDefinitions>

					<TextBlock Text="ITEMS" FontWeight="Bold"/>
					<TextBlock Grid.Column="1" Text="QTY" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Grid.Column="2" Text="PRICE" FontWeight="Bold" HorizontalAlignment="Right"/>
				</Grid>

				<!-- Items -->
				<ListView Grid.Row="1"
                          ItemsSource="{Binding BillItems}"
                          BorderThickness="0">
					<ListView.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="100"/>
								</Grid.ColumnDefinitions>

								<TextBlock Text="{Binding ItemName}" />

								<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
									<Button Content="-" Width="22"
                                            Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
									<TextBlock Text="{Binding Quantity}" Margin="6,0"/>
									<Button Content="+" Width="22"
                                            Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
								</StackPanel>

								<TextBlock Grid.Column="2"
                                           Text="{Binding TotalPrice}"
                                           HorizontalAlignment="Right"/>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>
		</Border>

		<!-- ================= FOOTER ================= -->
		<Border Grid.Row="1"
                Background="#2E2E2E"
                CornerRadius="6"
                Margin="0,10,0,0"
                Padding="12">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Payment -->
				<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
					<RadioButton Content="Cash" IsChecked="True" Foreground="White" Margin="10,0"/>
					<RadioButton Content="Card" Foreground="White" Margin="10,0"/>
					<RadioButton Content="UPI" Foreground="White" Margin="10,0"/>
					<RadioButton Content="Due" Foreground="White" Margin="10,0"/>
				</StackPanel>

				<!-- Actions -->
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="220"/>
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Horizontal">
						<Button Content="Save" Width="90" Margin="5"
                                Background="#C62828" Foreground="White"/>
						<Button Content="Save &amp; Print" Width="120" Margin="5"
                                Background="#C62828" Foreground="White"/>
						<Button Content="KOT" Width="80" Margin="5"
                                Background="#424242" Foreground="White"/>
					</StackPanel>

					<StackPanel Grid.Column="1" HorizontalAlignment="Right">
						<TextBlock Text="TOTAL"
                                   Foreground="White"
                                   FontSize="14"/>
						<TextBlock Text="{Binding GrandTotal}"
                                   Foreground="Yellow"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</Page>
