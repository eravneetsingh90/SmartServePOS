<Page
	x:Class="SmartServePOS.Views.LoginView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	Title="SmartServe POS"
	d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
	Background="#F4F6F8"
	mc:Ignorable="d">

	<Grid>

		<!--  🔴 HEADER  -->
		<Border
			Height="60"
			VerticalAlignment="Top"
			Background="#C62828">
			<Grid Margin="20,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock
					VerticalAlignment="Center"
					FontSize="20"
					FontWeight="Bold"
					Foreground="White"
					Text="SmartServe POS" />

				<StackPanel Grid.Column="1" HorizontalAlignment="Right">
					<TextBlock
						FontSize="14"
						FontWeight="SemiBold"
						Foreground="White"
						Text="Scoop Ice Cream Cafe" />
					<TextBlock
						FontSize="11"
						Foreground="#FFCDD2"
						Text="Terminal: POS-01" />
				</StackPanel>
			</Grid>
		</Border>

		<!--  ⚪ LOGIN CARD  -->
		<Border
			Width="420"
			Margin="0,40,0,0"
			Padding="30"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="White"
			CornerRadius="8">

			<Border.Effect>
				<DropShadowEffect
					BlurRadius="20"
					Opacity="0.15"
					ShadowDepth="0" />
			</Border.Effect>

			<StackPanel>

				<TextBlock
					HorizontalAlignment="Center"
					FontSize="20"
					FontWeight="SemiBold"
					Text="Login to your Billing Station" />

				<TextBlock
					Margin="0,5,0,25"
					HorizontalAlignment="Center"
					FontSize="13"
					Foreground="Gray"
					Text="Enter your username and password" />

				<!--  Username  -->
				<TextBlock FontSize="12" Text="User Name" />
				<TextBox
					Height="42"
					Padding="10"
					FontSize="15"
					Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

				<!--  Password  -->
				<TextBlock
					Margin="0,15,0,5"
					FontSize="12"
					Text="Password" />

				<!--  ⚠ PasswordBox cannot bind directly  -->

				<PasswordBox
					Height="42"
					Padding="10"
					FontSize="15"
					KeyDown="PasswordBox_KeyDown"
					PasswordChanged="PasswordBox_PasswordChanged" />

				<!--  LOGIN BUTTON  -->
				<Button
					Height="46"
					Margin="0,25,0,0"
					Background="#C62828"
					BorderThickness="0"
					Command="{Binding LoginCommand}"
					Cursor="Hand">

					<Grid>
						<!--  TEXT  -->
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="16"
							FontWeight="Bold"
							Foreground="White"
							Text="Log In"
							Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

						<!--  SPINNER  -->
						<ProgressBar
							Width="120"
							Height="6"
							IsIndeterminate="True"
							Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
					</Grid>
				</Button>

				<!--  ERROR  -->
				<TextBlock
					Margin="0,15,0,0"
					FontSize="12"
					Foreground="#C62828"
					Text="{Binding ErrorMessage}"
					TextAlignment="Center" />
			</StackPanel>
		</Border>

		<!--  FOOTER  -->
		<TextBlock
			Margin="0,0,0,15"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			FontSize="11"
			Foreground="Gray"
			Text="Need help? support@smartservepos.com | Version 1.0.0" />

	</Grid>
</Page>
