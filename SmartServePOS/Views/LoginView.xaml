<Window x:Class="SmartServePOS.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartServe POS"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8"
		KeyDown="Window_KeyDown"
		Icon="/Assets/Icons/SmartServe.ico">

	<Grid>

		<!-- 🔴 HEADER -->
		<Border Background="#C62828"
                Height="60"
                VerticalAlignment="Top">
			<Grid Margin="20,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Left -->
				<TextBlock Text="SmartServe POS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

				<!-- Right -->
				<StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
					<TextBlock Text="Scoop Ice Cream Cafe"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Right"/>
					<TextBlock Text="Terminal: POS-01"
                               Foreground="#FFCDD2"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ⚪ LOGIN CARD -->
		<Border Width="420"
                Padding="30"
                Background="White"
                CornerRadius="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,40,0,0">

			<Border.Effect>
				<DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.15"/>
			</Border.Effect>

			<StackPanel>

				<TextBlock Text="Login to your Billing Station"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

				<TextBlock Text="Enter your username and password"
                           FontSize="13"
                           Foreground="Gray"
                           Margin="0,5,0,25"
                           HorizontalAlignment="Center"/>

				<!-- Username -->
				<TextBlock Text="User Name"
                           FontSize="12"
                           Margin="0,0,0,5"/>

				<TextBox Height="42"
                         FontSize="15"
                         Padding="10"
                         Text="{Binding Username}"
                         BorderBrush="#DDD"/>

				<!-- Password -->
				<TextBlock Text="Password"
                           FontSize="12"
                           Margin="0,15,0,5"/>

				<PasswordBox Height="42"
                             FontSize="15"
                             Padding="10"
							 PasswordChanged="PasswordBox_PasswordChanged"/>

				<Button Height="46"
                        Margin="0,25,0,0"
                        Background="#C62828"
                        BorderThickness="0"
                        Click="LoginButton_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

					<Grid>
						<!-- LOGIN TEXT -->
						<TextBlock Text="Log In"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

						<!-- SPINNER -->
						<ProgressBar IsIndeterminate="True"
                     Width="120"
                     Height="6"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
					</Grid>
				</Button>


				<!-- Error -->
				<TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828"
                           FontSize="12"
                           Margin="0,15,0,0"
                           TextAlignment="Center"/>
			</StackPanel>
		</Border>

		<!-- Footer -->
		<TextBlock Text="Need help?  support@smartservepos.com   |   Version 1.0.0"
                   FontSize="11"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,15"/>

	</Grid>
</Window>
