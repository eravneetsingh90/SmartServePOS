<Window
	x:Class="SmartServePOS.Views.OrderDetailsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Order Details"
	Width="520"
	Height="600"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<StackPanel>
			<TextBlock
				Text="{Binding Order.OrderNumber}"
				FontSize="18"
				FontWeight="SemiBold"/>

			<TextBlock
				Margin="0,4,0,0"
				Foreground="#666"
				Text="{Binding Order.DisplayTime}"/>
		</StackPanel>

		<!-- ITEMS -->
		<Border
			Grid.Row="1"
			Margin="0,12"
			Padding="10"
			BorderBrush="#DDD"
			BorderThickness="1"
			CornerRadius="6">

			<StackPanel>
				<TextBlock
					Text="Items"
					FontWeight="SemiBold"
					Margin="0,0,0,8"/>

				<ItemsControl ItemsSource="{Binding Items}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<TextBlock Text="{Binding DisplayName}"/>

								<TextBlock
									Grid.Column="1"
									Margin="12,0"
									Text="{Binding Quantity}"/>

								<TextBlock
									Grid.Column="2"
									Text="{Binding LineTotal, StringFormat=₹ {0:N2}}"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<!-- PAYMENT SUMMARY -->
		<StackPanel Grid.Row="2">
			<Separator Margin="0,6"/>

			<TextBlock
				Text="{Binding Payment.Mode, StringFormat=Payment: {0}}"/>

			<TextBlock
				Text="{Binding Payment.Amount, StringFormat=Paid: ₹ {0:N2}}"
				FontWeight="SemiBold"/>

			<Button
				Margin="0,12,0,0"
				Width="100"
				HorizontalAlignment="Right"
				Content="Close"
				IsCancel="True"/>
		</StackPanel>
	</Grid>
</Window>
