<Page
	x:Class="SmartServePOS.Views.TableView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	d:DataContext="{d:DesignInstance Type=viewmodels:TableViewModel}"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<DockPanel Margin="12">
		<!--  Header  -->
		<Grid Margin="0,0,0,12" DockPanel.Dock="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				VerticalAlignment="Center"
				FontSize="20"
				FontWeight="SemiBold"
				Text="Table View" />

			<StackPanel
				Grid.Column="1"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<ToggleButton
					Padding="12,6"
					Background="#C62828"
					BorderThickness="0"
					Content="Delivery"
					Foreground="White" />
				<ToggleButton Padding="12,6" Content="Pick Up" />
			</StackPanel>
		</Grid>

		<!--  ================= STATUS LEGEND =================  -->
		<StackPanel
			Margin="0,0,0,16"
			HorizontalAlignment="Right"
			DockPanel.Dock="Top"
			Orientation="Horizontal">

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#BDBDBD"
				Text="● Blank Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#64B5F6"
				Text="● Running Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#81C784"
				Text="● Printed Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#FFD54F"
				Text="● Paid Table" />

			<TextBlock Foreground="#FFB74D" Text="● Running KOT" />
		</StackPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Tables}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel
							ItemHeight="120"
							ItemWidth="160"
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid
							Margin="8"
							Background="White"
							Cursor="Hand">
							<Grid.InputBindings>
								<MouseBinding
									Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
									CommandParameter="{Binding}"
									MouseAction="LeftClick" />
							</Grid.InputBindings>
							<!--  Dotted Border Look  -->
							<Border
								BorderBrush="#E0E0E0"
								BorderThickness="1"
								CornerRadius="8" />

							<Grid Margin="8">
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="36" />
								</Grid.RowDefinitions>

								<!--  Table Name  -->
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="16"
									FontWeight="SemiBold"
									Text="{Binding DisplayName}" />

								<!--  Amount  -->
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="12"
									FontWeight="Bold"
									Foreground="#2E7D32"
									Text="{Binding Amount, StringFormat=₹ {0:N2}}"
									Visibility="{Binding Amount, Converter={StaticResource AmountToVisibilityConverter}}" />

								<!--  Action Icons  -->
								<StackPanel
									Grid.Row="2"
									HorizontalAlignment="Center"
									VerticalAlignment="Bottom"
									Orientation="Horizontal">
									<Button
										Width="36"
										Height="34"
										Margin="0,0,2,0"
										Background="Transparent"
										BorderThickness="1"
										Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
										CommandParameter="{Binding}"
										Content="🖨">

										<Button.Style>
											<Style TargetType="Button">
												<!--  Hidden by default  -->
												<Setter Property="Visibility" Value="Collapsed" />

												<Style.Triggers>
													<!--  Show ONLY when Running Table  -->
													<DataTrigger Binding="{Binding StatusCode}" Value="RUNNING">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>

									</Button>


									<!--<Button
										Width="36"
										Height="34"
										Background="Transparent"
										BorderThickness="1"
										Content="👁">

										<Button.Style>
											<Style TargetType="Button">
												-->
									<!--  Hidden by default  -->
									<!--
												<Setter Property="Visibility" Value="Collapsed" />

												<Style.Triggers>
													-->
									<!--  Show ONLY when Running Table  -->
									<!--
													<DataTrigger Binding="{Binding StatusCode}" Value="RUNNING">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>

									</Button>-->
									<Button
										Width="36"
										Height="34"
										Margin="2,0,0,0"
										Background="Transparent"
										BorderThickness="1"
										Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
										CommandParameter="{Binding}"
										Content="💾">

										<Button.Style>
											<Style TargetType="Button">
												<!--  Hidden by default  -->
												<Setter Property="Visibility" Value="Collapsed" />

												<Style.Triggers>
													<!--  Show only when Printed Table  -->
													<DataTrigger Binding="{Binding StatusCode}" Value="PRINTED">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>

									</Button>

								</StackPanel>
							</Grid>
							<!--  Status Strip  -->
							<Border
								Width="6"
								HorizontalAlignment="Left"
								Background="{Binding ColorHex}"
								CornerRadius="6,0,0,6" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<Popup
			AllowsTransparency="True"
			DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
			IsOpen="{Binding IsPaymentPopupOpen, Mode=TwoWay}"
			Placement="Center"
			StaysOpen="False">

			<Border
				Width="460"
				MinHeight="220"
				Background="White"
				BorderBrush="#EAEAEA"
				BorderThickness="1"
				CornerRadius="12">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="40" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="14" />
					</Grid.RowDefinitions>

					<!--  HEADER  -->
					<Border
						Grid.Row="0"
						Padding="24,0,20,0"
						Background="Silver"
						BorderBrush="#E5E5E5"
						BorderThickness="0,0,0,1">
						<DockPanel>
							<TextBlock
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								FontSize="14"
								FontWeight="SemiBold"
								Text="{Binding SelectedTableName}" />
							<TextBlock
								Margin="18,0,0,0"
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								FontSize="14"
								FontWeight="SemiBold"
								Foreground="#2E7D32"
								Text="{Binding BillTotal, StringFormat=₹{0:N2}}" />
							<Button
								HorizontalAlignment="Right"
								Background="Transparent"
								BorderThickness="0"
								Command="{Binding ClosePaymentPopupCommand}"
								Content="✕"
								Cursor="Hand"
								DockPanel.Dock="Right"
								FontSize="14"
								Foreground="#888" />
						</DockPanel>
					</Border>

					<!--  PAYMENT TYPE  -->
					<StackPanel Grid.Row="1" Margin="24,14,24,14">
						<TextBlock
							Margin="0,0,0,6"
							FontWeight="SemiBold"
							Text="Payment Type" />

						<StackPanel Orientation="Horizontal">
							<RadioButton
								Margin="5"
								Content="Cash"
								GroupName="Payment"
								IsChecked="{Binding SelectedPaymentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cash}" />

							<RadioButton
								Margin="5"
								Content="UPI"
								GroupName="Payment"
								IsChecked="{Binding SelectedPaymentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=UPI}" />

							<RadioButton
								Margin="5"
								Content="Part"
								GroupName="Payment"
								IsChecked="{Binding SelectedPaymentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Part}" />

						</StackPanel>
					</StackPanel>

					<Grid
						Grid.Row="2"
						Margin="24,10,24,10"
						Visibility="{Binding IsPartPayment, Converter={StaticResource BoolToVisibilityConverter}}">

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<!--  Cash Paid  -->
						<Grid Grid.Row="0" Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="160" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="Cash Paid" />
							<TextBox
								Grid.Column="1"
								HorizontalContentAlignment="Right"
								Text="{Binding PartPaymentCash, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>

						<!--  Remaining  -->
						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="160" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="Remaining Amount" />
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								FontWeight="SemiBold"
								Foreground="#D32F2F"
								Text="{Binding RemainingAmount, StringFormat=₹{0:N2}}" />
						</Grid>

					</Grid>

					<!--  AMOUNTS  -->
					<Grid Grid.Row="3" Margin="24,10,24,10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="160" />
							</Grid.ColumnDefinitions>

							<TextBlock
								VerticalAlignment="Center"
								FontWeight="SemiBold"
								Text="Settlement Amount" />
							<TextBox
								Grid.Column="1"
								HorizontalContentAlignment="Right"
								Text="{Binding BillTotal}" />

						</Grid>
					</Grid>

					<!--  ACTIONS  -->
					<StackPanel
						Grid.Row="4"
						Margin="24,14,24,0"
						HorizontalAlignment="Right"
						Orientation="Horizontal">

						<Button
							Margin="0,0,10,0"
							Padding="12,6"
							Command="{Binding ClosePaymentPopupCommand}"
							Content="Cancel"
							Cursor="Hand" />

						<Button
							Padding="16,6"
							Background="#4CAF50"
							Command="{Binding SettleAndSaveCommand}"
							Content="Settle &amp; Save"
							Cursor="Hand"
							Foreground="White" />
					</StackPanel>

				</Grid>
			</Border>
		</Popup>

	</DockPanel>
</Page>
