<Page
	x:Class="SmartServePOS.Views.TableView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	d:DataContext="{d:DesignInstance Type=viewmodels:TableViewModel}"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<DockPanel Margin="12">
		<!--  Header  -->
		<Grid Margin="0,0,0,12" DockPanel.Dock="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				VerticalAlignment="Center"
				FontSize="20"
				FontWeight="SemiBold"
				Text="Table View" />

			<StackPanel
				Grid.Column="1"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<ToggleButton
					Padding="12,6"
					Background="#C62828"
					BorderThickness="0"
					Content="Delivery"
					Foreground="White" />
				<ToggleButton Padding="12,6" Content="Pick Up" />
			</StackPanel>
		</Grid>

		<!--  ================= STATUS LEGEND =================  -->
		<StackPanel
			Margin="0,0,0,16"
			HorizontalAlignment="Right"
			DockPanel.Dock="Top"
			Orientation="Horizontal">

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#BDBDBD"
				Text="● Blank Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#64B5F6"
				Text="● Running Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#81C784"
				Text="● Printed Table" />

			<TextBlock
				Margin="0,0,16,0"
				Foreground="#FFD54F"
				Text="● Paid Table" />

			<TextBlock Foreground="#FFB74D" Text="● Running KOT" />
		</StackPanel>

		<!--  Body: responsive, scrollable grid of table tiles  -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Tables}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel
							ItemHeight="120"
							ItemWidth="160"
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border
							Width="120"
							Height="95"
							Margin="8"
							Background="White"
							BorderBrush="#BDBDBD"
							BorderThickness="1"
							CornerRadius="6"
							Cursor="Hand">

							<Grid>

								<!--  Dotted Border Look  -->
								<Border
									BorderBrush="#BDBDBD"
									BorderThickness="1"
									CornerRadius="6" />

								<Grid Margin="8">
									<Grid.RowDefinitions>
										<RowDefinition Height="*" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!--  Table Name  -->
									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="16"
										FontWeight="SemiBold"
										Text="{Binding DisplayName}" />

									<!--  Amount  -->
									<TextBlock
										Grid.Row="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="14"
										FontWeight="Bold"
										Foreground="#2E7D32"
										Text="{Binding Amount, StringFormat=₹ {0:N2}}" />
								</Grid>

								<!--  Status Strip  -->
								<Border
									Width="6"
									HorizontalAlignment="Left"
									Background="{Binding ColorHex}"
									CornerRadius="6,0,0,6" />

								<!--  Action Icons  -->
								<!--<StackPanel
									Margin="0,0,6,6"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom"
									Orientation="Horizontal">

									<Button
										Width="26"
										Height="26"
										Margin="2"
										Background="Transparent"
										BorderThickness="0"
										Content="🖨" />

									<Button
										Width="26"
										Height="26"
										Margin="2"
										Background="Transparent"
										BorderThickness="0"
										Content="👁" />
								</StackPanel>-->

							</Grid>
						</Border>
						<!--<Button
							Width="150"
							Height="100"
							Margin="8"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Background="White"
							BorderBrush="#BDBDBD"
							BorderThickness="1"
							Click="TableButton_Click"
							CommandParameter="{Binding}"
							ToolTip="{Binding DisplayName}">
							<Grid Margin="4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								-->
						<!--  Status color strip  -->
						<!--
								<Border
									Grid.RowSpan="2"
									Grid.Column="0"
									Background="{Binding ColorHex}"
									CornerRadius="4,0,0,4" />

								-->
						<!--  Main Content  -->
						<!--
								<StackPanel
									Grid.Row="0"
									Grid.Column="1"
									Margin="10,6"
									VerticalAlignment="Center">

									<TextBlock
										FontSize="16"
										FontWeight="SemiBold"
										Text="{Binding DisplayName}"
										TextTrimming="CharacterEllipsis" />

									<TextBlock
										Margin="0,4,0,0"
										FontSize="14"
										Foreground="#616161"
										Text="{Binding Amount, StringFormat=₹ {0}}" />
								</StackPanel>

								-->
						<!--  Status text (bottom right)  -->
						<!--<TextBlock Grid.Column="1"
										   Grid.Row="1"
										   Text="{Binding StatusName}"
										   FontSize="11"
										   Foreground="#757575"
										   HorizontalAlignment="Right"
										   Margin="0,0,6,4"/>-->
						<!--
							</Grid>

						</Button>-->
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</Page>
