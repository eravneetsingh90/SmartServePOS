<Page
	x:Class="SmartServePOS.Views.StockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SmartServePOS.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	d:DataContext="{d:DesignInstance Type=viewmodels:StockViewModel}"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<DockPanel Margin="12">

		<!--  HEADER  -->
		<Grid Margin="0,0,0,12" DockPanel.Dock="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel>
				<TextBlock
					FontSize="20"
					FontWeight="SemiBold"
					Text="Ice Cream Stock" />
				<TextBlock Foreground="#666" Text="Manage sealed ice cream inventory" />
			</StackPanel>

			<StackPanel
				Grid.Column="1"
				VerticalAlignment="Center"
				Orientation="Horizontal">

				<Button
					Margin="4"
					Padding="12,6"
					Command="{Binding AddStockCommand}"
					Content="Add Stock" />

				<Button
					Margin="4"
					Padding="12,6"
					Command="{Binding AdjustStockCommand}"
					Content="Adjust Stock" />
				<!--  IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" />  -->
			</StackPanel>
		</Grid>

		<!--  SEARCH BAR  -->
		<Border
			Margin="0,0,0,8"
			Padding="8"
			Background="White">
			<TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
		</Border>

		<!--  STOCK GRID  -->
		<Border Background="White">
			<DataGrid
				AutoGenerateColumns="False"
				GridLinesVisibility="Horizontal"
				HeadersVisibility="Column"
				IsReadOnly="True"
				ItemsSource="{Binding Items}"
				SelectedItem="{Binding SelectedItem}">

				<DataGrid.Columns>

					<DataGridTextColumn
						Width="2*"
						Binding="{Binding BrandName}"
						Header="Brand" />

					<DataGridTextColumn
						Width="3*"
						Binding="{Binding VariantName}"
						Header="Variant" />

					<DataGridTextColumn
						Width="*"
						Binding="{Binding Quantity}"
						Header="Quantity" />

					<DataGridTextColumn
						Width="*"
						Binding="{Binding Status}"
						Header="Status" />

				</DataGrid.Columns>
			</DataGrid>
		</Border>

	</DockPanel>
</Page>
