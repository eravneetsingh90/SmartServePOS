<Page
	x:Class="SmartServePOS.Views.ProductView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  ================= CATEGORY FILTER =================  -->
		<Border
			Grid.Column="0"
			Padding="6"
			Background="White"
			IsHitTestVisible="{Binding IsSearchActive, Converter={StaticResource BoolToHitTestConverter}}"
			Opacity="{Binding IsSearchActive, Converter={StaticResource BoolToOpacityConverter}}">

			<GroupBox
				Background="#262626"
				FontSize="14"
				Header="Categories">
				<ListBox
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Categories}"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding SelectedCategory}">

					<!--  Remove default selection visuals  -->
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="2" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								x:Name="Root"
								Height="46"
								Background="#333333">

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<!--  Accent Bar  -->
									<Border
										x:Name="Accent"
										Grid.Column="0"
										Background="#C62828"
										Visibility="Collapsed" />

									<!--  Text  -->
									<TextBlock
										Grid.Column="1"
										Margin="12,0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Foreground="White"
										Text="{Binding Name}" />
								</Grid>
							</Border>

							<!--  STATES  -->
							<DataTemplate.Triggers>

								<!--  Selected  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#3E3E3E" />
									<Setter TargetName="Accent" Property="Visibility" Value="Visible" />
								</DataTrigger>

								<!--  Hover  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#444444" />
								</DataTrigger>

							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</GroupBox>
		</Border>
		<!--  ================= PRODUCT GRID =================  -->
		<Border
			Grid.Column="1"
			Padding="16"
			Background="White"
			BorderBrush="#E0E0E0"
			BorderThickness="1">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  HEADER  -->
				<DockPanel Margin="0,0,0,12">

					<TextBlock
						DockPanel.Dock="Left"
						FontSize="18"
						FontWeight="SemiBold"
						Text="{Binding SelectedCategory.Name, StringFormat=Products – {0}}" />

					<StackPanel
						Margin="10,0,0,0"
						DockPanel.Dock="Right"
						Orientation="Horizontal">

						<Button
							Margin="0,0,8,0"
							Background="#F3F3F3"
							BorderBrush="#CCC"
							Command="{Binding AddProductCommand}"
							Content="+ Add Product" />

						<Button
							Background="#2E7D32"
							Command="{Binding SaveCommand}"
							Content="Save Changes"
							Foreground="White"
							IsEnabled="{Binding CanSave}" />

						<Button
							Background="#0047AB"
							Command="{Binding RefreshCommand}"
							Content="Refresh 🔄"
							Foreground="White" />
					</StackPanel>
				</DockPanel>

				<!--  DATAGRID  -->
				<DataGrid
					Grid.Row="1"
					AutoGenerateColumns="False"
					BorderThickness="0"
					CanUserAddRows="False"
					GridLinesVisibility="None"
					HeadersVisibility="Column"
					ItemsSource="{Binding Products}"
					RowHeight="38"
					SelectionMode="Single">

					<!--  HEADER STYLE  -->
					<DataGrid.ColumnHeaderStyle>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background" Value="#F7F7F7" />
							<Setter Property="Foreground" Value="#555" />
							<Setter Property="FontWeight" Value="SemiBold" />
							<Setter Property="Padding" Value="12,8" />
							<Setter Property="BorderThickness" Value="0,0,0,1" />
							<Setter Property="BorderBrush" Value="#DDD" />
						</Style>
					</DataGrid.ColumnHeaderStyle>

					<!--  COLUMNS  -->
					<DataGrid.Columns>

						<DataGridTextColumn
							Width="80"
							Binding="{Binding DisplayOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Order">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Center" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="HorizontalContentAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Product Name">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,0" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="Padding" Value="8" />
									<Setter Property="BorderBrush" Value="#C62828" />
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>
						<DataGridCheckBoxColumn
							Width="60"
							Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Active">
							<DataGridCheckBoxColumn.ElementStyle>
								<Style TargetType="CheckBox">
									<Setter Property="HorizontalAlignment" Value="Center" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridCheckBoxColumn.ElementStyle>
						</DataGridCheckBoxColumn>

						<!--  DELETE  -->
						<DataGridTemplateColumn Width="60" Header="Delete">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button
										Background="Transparent"
										BorderThickness="0"
										Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
										CommandParameter="{Binding}"
										Content="✕"
										Foreground="Red" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

					</DataGrid.Columns>
				</DataGrid>

			</Grid>
		</Border>
	</Grid>
</Page>
