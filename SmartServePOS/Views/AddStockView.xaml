<Page
	x:Class="SmartServePOS.Views.AddStockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="48" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ================= TOP BAR =================  -->
		<Grid Grid.Row="0" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="18"
				FontWeight="SemiBold"
				Text="Add Stock" />

			<TextBox
				Grid.Column="1"
				Height="36"
				Padding="8"
				BorderBrush="#CCCCCC"
				FontSize="14"
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

			<Button
				Grid.Column="2"
				Width="100"
				Margin="6,4"
				Background="#555"
				Command="{Binding ReloadCommand}"
				Content="Refresh"
				Foreground="White" />
		</Grid>
		<!--  ================= MAIN =================  -->
		<Grid Grid.Row="1" Margin="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="180" />
				<!--  Categories  -->
				<ColumnDefinition Width="200" />
				<!--  Products  -->
				<ColumnDefinition Width="220" />
				<!--  Variants  -->
				<ColumnDefinition Width="*" />
				<!--  Bill  -->
			</Grid.ColumnDefinitions>
			<!--  ================= CATEGORIES =================  -->
			<Border
				Grid.Column="0"
				Padding="6"
				Background="#262626">

				<ListBox
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Categories}"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding SelectedCategory}">

					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="2" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								x:Name="Root"
								Height="46"
								Background="#333"
								Cursor="Hand">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<Border
										x:Name="Accent"
										Grid.Column="0"
										Background="#C62828"
										Visibility="Collapsed" />

									<TextBlock
										Grid.Column="1"
										Margin="12,0"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="SemiBold"
										Foreground="White"
										Text="{Binding Name}" />
								</Grid>
							</Border>

							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#3E3E3E" />
									<Setter TargetName="Accent" Property="Visibility" Value="Visible" />
								</DataTrigger>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#444444" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
			</Border>

			<!--  ================= products =================  -->
			<Border
				Grid.Column="1"
				Margin="0,0,12,0"
				Background="White"
				BorderBrush="#F3F4F6"
				BorderThickness="1">


				<ListBox
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Products}"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding SelectedProduct}">

					<!--  Remove default selection visuals  -->
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="2" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								x:Name="Root"
								Height="46"
								Background="#eaeaea">

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<!--  Accent Bar  -->
									<Border
										x:Name="Accent"
										Grid.Column="0"
										Background="#C62828"
										Visibility="Collapsed" />

									<!--  Text  -->
									<TextBlock
										Grid.Column="1"
										Margin="12,0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Foreground="Black"
										Text="{Binding Name}" />
								</Grid>
							</Border>

							<!--  STATES  -->
							<DataTemplate.Triggers>

								<!--  Selected  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#D1D5DB" />
									<Setter TargetName="Accent" Property="Visibility" Value="Visible" />
								</DataTrigger>

								<!--  Hover  -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
									<Setter TargetName="Root" Property="Background" Value="#E5E7EB" />
								</DataTrigger>

							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<!--  ================= VARIANTS =================  -->
			<Border
				Grid.Column="2"
				Padding="6"
				Background="#FAFAFA"
				CornerRadius="6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  Product Name  -->
					<TextBlock
						Margin="4,2,4,6"
						FontSize="12"
						FontWeight="Bold"
						Text="{Binding SelectedProduct.Name}" />

					<ListBox
						Grid.Row="1"
						Background="Transparent"
						BorderThickness="0"
						ItemsSource="{Binding Variants}"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						ScrollViewer.VerticalScrollBarVisibility="Auto">

						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="0" />
								<Setter Property="Margin" Value="6" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								<Setter Property="BorderThickness" Value="0" />
								<Setter Property="Background" Value="Transparent" />
								<EventSetter Event="PreviewMouseLeftButtonUp" Handler="VariantClicked" />
							</Style>
						</ListBox.ItemContainerStyle>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border
									Padding="12"
									Background="White"
									BorderBrush="#E53935"
									BorderThickness="1"
									CornerRadius="6"
									Cursor="Hand">
									<TextBlock
										Grid.Column="0"
										FontSize="13"
										FontWeight="SemiBold"
										Foreground="#222"
										Text="{Binding VariantName}"
										TextTrimming="None"
										TextWrapping="Wrap" />
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>
				</Grid>
			</Border>

			<!--  ================= STOCK ENTRY PANEL =================  -->
			<!--
			<Border
				Grid.Column="3"
				Padding="8"
				Background="White"
				CornerRadius="6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>


			<TextBlock
						FontSize="12"
						FontWeight="Bold"
						Text="STOCK ITEMS" />

			
			<ItemsControl Grid.Row="1" ItemsSource="{Binding StockRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Margin="2"
									Padding="4"
									BorderBrush="#DDD"
									BorderThickness="1"
									CornerRadius="6">

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="70" />
											<ColumnDefinition Width="60" />
										</Grid.ColumnDefinitions>

										<Button
											Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
											CommandParameter="{Binding}"
											Content="✕"
											Foreground="Red" />

										<TextBlock
											Grid.Column="1"
											FontSize="12"
											Text="{Binding DisplayName}"
											TextWrapping="Wrap" />

										<TextBox
											Grid.Column="2"
											HorizontalContentAlignment="Center"
											Text="{Binding Quantity}" />

										<TextBlock
											Grid.Column="3"
											HorizontalAlignment="Right"
											Text="{Binding Unit}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button
						Grid.Row="2"
						Height="40"
						Background="#2E7D32"
						Command="{Binding SaveStockCommand}"
						Content="Save Stock"
						Foreground="White" />
				</Grid>
			</Border>
			-->
			<Border
				Grid.Column="3"
				Padding="8"
				Background="White"
				CornerRadius="6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Header  -->
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="32" />
							<!--  Remove  -->
							<ColumnDefinition Width="180" />
							<!--  Item  -->
							<ColumnDefinition Width="*" />
							<!--  Qty  -->
							<!--<ColumnDefinition Width="90" />-->
							<!--  Price  -->
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="1"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="ITEMS" />

						<TextBlock
							Grid.Column="3"
							HorizontalAlignment="Center"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="QTY." />

						<!--<TextBlock
							Grid.Column="3"
							HorizontalAlignment="Right"
							FontSize="12"
							FontWeight="Bold"
							Foreground="#555"
							Text="PRICE" />-->
					</Grid>


					<!--  Bill Items  -->
					<ItemsControl
						Grid.Row="1"
						Margin="0,6,0,0"
						ItemsSource="{Binding StockRows}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Padding="2"
									BorderBrush="#E6E6E6"
									BorderThickness="1"
									CornerRadius="6">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="30" />
											<ColumnDefinition Width="180" />
											<ColumnDefinition Width="*" />

										</Grid.ColumnDefinitions>
										<!--  REMOVE  -->
										<Button
											Grid.Column="0"
											Width="24"
											Height="24"
											Padding="5"
											Background="Transparent"
											BorderThickness="0"
											Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
											CommandParameter="{Binding}"
											Content="✕"
											Cursor="Hand"
											Foreground="Red" />
										<!--  ITEM  -->
										<TextBlock
											Grid.Column="1"
											VerticalAlignment="Center"
											FontSize="12"
											FontWeight="SemiBold"
											Text="{Binding DisplayName}"
											TextWrapping="Wrap" />
										<!--  QTY  -->
										<Border
											Grid.Column="2"
											Padding="2"
											HorizontalAlignment="Center"
											BorderBrush="#DDD"
											BorderThickness="1"
											CornerRadius="4">

											<StackPanel Orientation="Horizontal">
												<Button
													Width="26"
													Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="−"
													Cursor="Hand" />

												<TextBlock
													Width="26"
													VerticalAlignment="Center"
													FontWeight="Bold"
													Text="{Binding Quantity}"
													TextAlignment="Center" />

												<Button
													Width="26"
													Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="+"
													Cursor="Hand" />
											</StackPanel>
										</Border>

									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Border
						Grid.Row="2"
						Padding="10"
						Background="#2E2E2E">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="180" />
							</Grid.ColumnDefinitions>

							<StackPanel Orientation="Horizontal">
								<Button
									Width="90"
									Margin="4"
									Background="#C62828"
									Command="{Binding SaveCommand}"
									Content="Save"
									Foreground="White"
									IsEnabled="{Binding IsEditable}" />
							</StackPanel>

							<StackPanel Grid.Column="1" HorizontalAlignment="Right">
								<TextBlock
									HorizontalAlignment="Right"
									FontSize="12"
									Foreground="White"
									Text="TOTAL" />
								<TextBlock
									HorizontalAlignment="Right"
									FontSize="30"
									FontWeight="Bold"
									Foreground="Yellow"
									Text="{Binding GrandTotal, StringFormat=₹{0}}" />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Page>

