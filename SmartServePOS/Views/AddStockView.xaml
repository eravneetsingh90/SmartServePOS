<Page
	x:Class="SmartServePOS.Views.AddStockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	d:DataContext="{d:DesignInstance Type=viewmodels:AddStockViewModel}"
	Background="#F5F5F5"
	mc:Ignorable="d">

	<DockPanel Margin="16">

		<!--  ================= HEADER =================  -->
		<StackPanel Margin="0,0,0,16" DockPanel.Dock="Top">
			<TextBlock
				FontSize="22"
				FontWeight="SemiBold"
				Text="Add Stock" />

			<TextBlock
				Margin="0,4,0,0"
				Foreground="#666"
				Text="Use this screen to add new stock received or opening balance." />
		</StackPanel>

		<!--  ================= CARD =================  -->
		<Border
			Width="480"
			Padding="24"
			HorizontalAlignment="Left"
			Background="White"
			CornerRadius="8">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<!--  Item  -->
					<RowDefinition Height="Auto" />
					<!--  Meta  -->
					<RowDefinition Height="Auto" />
					<!--  Current  -->
					<RowDefinition Height="Auto" />
					<!--  Qty  -->
					<RowDefinition Height="Auto" />
					<!--  Reason  -->
					<RowDefinition Height="Auto" />
					<!--  Remarks  -->
					<RowDefinition Height="Auto" />
					<!--  Buttons  -->
				</Grid.RowDefinitions>

				<!--  ================= STOCK ITEM =================  -->
				<TextBlock FontWeight="SemiBold" Text="Stock Item" />

				<ComboBox
					Grid.Row="1"
					Height="34"
					Margin="0,6,0,14"
					DisplayMemberPath="DisplayName"
					IsEditable="True"
					IsTextSearchEnabled="True"
					ItemsSource="{Binding StockItems}"
					SelectedItem="{Binding SelectedStockItem}" />

				<!--  ================= META INFO =================  -->
				<Grid Grid.Row="2" Margin="0,0,0,14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock
							FontSize="12"
							Foreground="#666"
							Text="Item Type" />
						<TextBlock FontWeight="SemiBold" Text="{Binding SelectedStockItem.ItemType}" />
					</StackPanel>

					<StackPanel Grid.Column="1">
						<TextBlock
							FontSize="12"
							Foreground="#666"
							Text="Unit" />
						<TextBlock FontWeight="SemiBold" Text="{Binding SelectedStockItem.Unit}" />
					</StackPanel>
				</Grid>

				<!--  ================= CURRENT STOCK =================  -->
				<StackPanel Grid.Row="3" Margin="0,0,0,14">
					<TextBlock
						FontSize="12"
						Foreground="#666"
						Text="Current Stock" />
					<!--<TextBlock
						FontSize="16"
						FontWeight="SemiBold"
						Foreground="#2E7D32"
						Text="{Binding SelectedStockItem.CurrentQuantity}" />-->
				</StackPanel>

				<!--  ================= ADD QUANTITY =================  -->
				<Grid Grid.Row="4" Margin="0,0,0,14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="80" />
					</Grid.ColumnDefinitions>

					<TextBox
						Height="34"
						VerticalContentAlignment="Center"
						Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding SelectedStockItem.Unit}" />
				</Grid>

				<!--  ================= REASON =================  -->
				<StackPanel Grid.Row="5" Margin="0,0,0,14">
					<TextBlock FontWeight="SemiBold" Text="Reason" />
					<ComboBox
						Height="34"
						Margin="0,6,0,0"
						ItemsSource="{Binding Reasons}"
						SelectedItem="{Binding SelectedReason}" />
				</StackPanel>

				<!--  ================= REMARKS (OPTIONAL) =================  -->
				<StackPanel Grid.Row="6" Margin="0,0,0,20">
					<TextBlock
						FontSize="12"
						Foreground="#666"
						Text="Remarks (optional)" />
					<TextBox
						Height="60"
						AcceptsReturn="True"
						TextWrapping="Wrap" />
				</StackPanel>

				<!--  ================= ACTIONS =================  -->
				<StackPanel
					Grid.Row="7"
					HorizontalAlignment="Right"
					Orientation="Horizontal">

					<Button
						Width="90"
						Margin="0,0,8,0"
						Command="{Binding ResetCommand}"
						Content="Reset" />

					<Button
						Width="120"
						Command="{Binding SaveCommand}"
						Content="Add Stock"
						IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}" />
				</StackPanel>

				<!--<hc:Loading IsLoading="{Binding IsSaving}" />-->
			</Grid>
		</Border>
	</DockPanel>
</Page>
