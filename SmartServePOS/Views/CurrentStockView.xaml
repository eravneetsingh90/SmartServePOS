<Page
	x:Class="SmartServePOS.Views.CurrentStockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	Background="#F5F5F5">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ================= HEADER =================  -->
		<TextBlock
			Margin="0,0,0,12"
			FontSize="26"
			FontWeight="SemiBold"
			Foreground="#222"
			Text="View Stock" />

		<!--  ================= SUMMARY CARDS =================  -->
		<UniformGrid
			Grid.Row="1"
			Margin="0,0,0,16"
			Columns="4">

			<!--  Total Items  -->
			<Border
				Margin="6"
				Padding="16"
				Background="White"
				CornerRadius="8">
				<StackPanel>
					<TextBlock
						FontSize="13"
						Foreground="#666"
						Text="Total Items" />
					<TextBlock
						FontSize="28"
						FontWeight="SemiBold"
						Text="{Binding TotalItems}" />
				</StackPanel>
			</Border>

			<!--  In Stock  -->
			<Border
				Margin="6"
				Padding="16"
				Background="White"
				CornerRadius="8">
				<StackPanel>
					<TextBlock
						FontSize="13"
						Foreground="#666"
						Text="In Stock" />
					<TextBlock
						FontSize="28"
						FontWeight="SemiBold"
						Foreground="#2E7D32"
						Text="{Binding InStockCount}" />
				</StackPanel>
			</Border>

			<!--  Low Stock  -->
			<Border
				Margin="6"
				Padding="16"
				Background="White"
				CornerRadius="8">
				<StackPanel>
					<TextBlock
						FontSize="13"
						Foreground="#666"
						Text="Low Stock" />
					<TextBlock
						FontSize="28"
						FontWeight="SemiBold"
						Foreground="#EF6C00"
						Text="{Binding LowStockCount}" />
				</StackPanel>
			</Border>

			<!--  Out of Stock  -->
			<Border
				Margin="6"
				Padding="16"
				Background="White"
				CornerRadius="8">
				<StackPanel>
					<TextBlock
						FontSize="13"
						Foreground="#666"
						Text="Out of Stock" />
					<TextBlock
						FontSize="28"
						FontWeight="SemiBold"
						Foreground="#C62828"
						Text="{Binding OutOfStockCount}" />
				</StackPanel>
			</Border>

		</UniformGrid>

		<!--  ================= FILTER BAR =================  -->
		<Grid Grid.Row="2" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!--  Search  -->
			<TextBox
				Height="36"
				Margin="0,0,12,0"
				VerticalContentAlignment="Center"
				FontSize="14"
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />


			<!--  Category  -->
			<ComboBox
				Grid.Column="1"
				Width="160"
				Height="36"
				Margin="0,0,12,0"
				FontSize="14"
				ItemsSource="{Binding Categories}"
				SelectedItem="{Binding SelectedCategory}" />


			<!--  Stock Filter  -->
			<ComboBox
				Grid.Column="2"
				Width="160"
				Height="36"
				FontSize="14"
				ItemsSource="{Binding Statuses}"
				SelectedItem="{Binding SelectedStatus}" />

		</Grid>

		<!--  ================= STOCK LIST =================  -->
		<DataGrid
			Grid.Row="3"
			AutoGenerateColumns="False"
			Background="White"
			BorderThickness="0"
			CanUserAddRows="False"
			GridLinesVisibility="None"
			HeadersVisibility="Column"
			IsReadOnly="True"
			ItemsSource="{Binding StockItems}"
			RowHeight="44">

			<DataGrid.Columns>

				<!--  Item Name  -->
				<DataGridTextColumn
					Width="2*"
					Binding="{Binding ItemName}"
					Header="Item" />

				<!--  Category  -->
				<DataGridTextColumn
					Width="1.5*"
					Binding="{Binding Category}"
					Header="Category" />

				<!--  Quantity  -->
				<DataGridTextColumn
					Width="1*"
					Binding="{Binding CurrentStock}"
					Header="Quantity" />

				<!--  Unit  -->
				<DataGridTextColumn
					Width="0.8*"
					Binding="{Binding Unit}"
					Header="Unit" />

				<!--  Status  -->

				<DataGridTextColumn
					Width="1*"
					Binding="{Binding Status}"
					Header="Status">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="FontWeight" Value="SemiBold" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Status}" Value="InStock">
									<Setter Property="Foreground" Value="#2E7D32" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}" Value="LowStock">
									<Setter Property="Foreground" Value="#EF6C00" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}" Value="OutOfStock">
									<Setter Property="Foreground" Value="#C62828" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>


			</DataGrid.Columns>
		</DataGrid>

	</Grid>
</Page>

