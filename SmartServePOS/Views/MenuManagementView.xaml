<Page x:Class="SmartServePOS.Views.MenuManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

	<Grid Margin="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<StackPanel Margin="0,0,0,24">
			<TextBlock Text="Menu Management"
                       FontSize="24"
                       FontWeight="Bold"/>
			<TextBlock Text="Manage categories, products and variants"
                       Foreground="#666"
                       Margin="0,4,0,0"/>
		</StackPanel>

		<!-- TILE GRID -->
		<UniformGrid Grid.Row="1"
                     Columns="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">

			<!-- CATEGORY TILE -->
			<Border Margin="12"
                    Width="260"
                    Height="160"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="OpenCategories_Click">

				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

					<TextBlock Text="📂"
                               FontSize="36"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Categories"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Ice Cream, Burgers, Beverages"
                               FontSize="12"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="12,6,12,0"/>
				</StackPanel>
			</Border>

			<!-- PRODUCT TILE -->
			<Border Margin="12"
                    Width="260"
                    Height="160"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="OpenProducts_Click">

				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

					<TextBlock Text="🍦"
                               FontSize="36"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Products"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Vanilla, Chocolate, Burger"
                               FontSize="12"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="12,6,12,0"/>
				</StackPanel>
			</Border>

			<!-- VARIANT TILE -->
			<Border Margin="12"
                    Width="260"
                    Height="160"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="OpenVariants_Click">

				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

					<TextBlock Text="🏷️"
                               FontSize="36"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Variants"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Single, Double, Tub, Brick"
                               FontSize="12"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="12,6,12,0"/>
				</StackPanel>
			</Border>

		</UniformGrid>

	</Grid>
</Page>
