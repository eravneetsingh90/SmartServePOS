<Page
	x:Class="SmartServePOS.Views.MenuManagementView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Background="#F5F5F5">

	<Grid Margin="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  HEADER  -->
		<StackPanel Margin="0,0,0,24">
			<TextBlock
				FontSize="24"
				FontWeight="Bold"
				Text="Menu Management" />
			<TextBlock
				Margin="0,4,0,0"
				Foreground="#666"
				Text="Manage categories, products and variants" />
		</StackPanel>

		<!--  TILE GRID  -->
		<UniformGrid
			Grid.Row="1"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Columns="3">

			<!--  CATEGORY TILE  -->
			<Border
				Width="260"
				Height="160"
				Margin="12"
				Background="White"
				BorderBrush="#E0E0E0"
				BorderThickness="1"
				CornerRadius="8"
				Cursor="Hand"
				MouseLeftButtonUp="OpenCategories_Click">

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="36"
						Text="📂" />

					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="16"
						FontWeight="SemiBold"
						Text="Categories" />

					<TextBlock
						Margin="12,6,12,0"
						FontSize="12"
						Foreground="#777"
						Text="Ice Cream, Burgers, Beverages"
						TextAlignment="Center" />
				</StackPanel>
			</Border>

			<!--  PRODUCT TILE  -->
			<Border
				Width="260"
				Height="160"
				Margin="12"
				Background="White"
				BorderBrush="#E0E0E0"
				BorderThickness="1"
				CornerRadius="8"
				Cursor="Hand"
				MouseLeftButtonUp="OpenProducts_Click">

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="36"
						Text="🍦" />

					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="16"
						FontWeight="SemiBold"
						Text="Products" />

					<TextBlock
						Margin="12,6,12,0"
						FontSize="12"
						Foreground="#777"
						Text="Vanilla, Chocolate, Burger"
						TextAlignment="Center" />
				</StackPanel>
			</Border>

			<!--  VARIANT TILE  -->
			<Border
				Width="260"
				Height="160"
				Margin="12"
				Background="White"
				BorderBrush="#E0E0E0"
				BorderThickness="1"
				CornerRadius="8"
				Cursor="Hand"
				MouseLeftButtonUp="OpenVariants_Click">

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="36"
						Text="🏷️" />

					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="16"
						FontWeight="SemiBold"
						Text="Products Variants" />

					<TextBlock
						Margin="12,6,12,0"
						FontSize="12"
						Foreground="#777"
						Text="Single, Double, Tub, Brick"
						TextAlignment="Center" />
				</StackPanel>
			</Border>

		</UniformGrid>

	</Grid>
</Page>
