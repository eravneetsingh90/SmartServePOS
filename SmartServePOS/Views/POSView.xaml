<Window x:Class="SmartServePOS.Views.POSView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
		xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels" 
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		Title="SmartServe POS"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        Background="#F5F6F8"
		Icon="/Assets/Icons/SmartServe.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 🔴 HEADER -->
		<Border Background="#C62828">
			<Grid Margin="15,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Logo -->
				<TextBlock Text="SmartServe POS"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

				<!-- New Order -->
				<Button Grid.Column="1"
                        Content="New Order"
                        Margin="20,0"
                        Padding="15,6"
                        Background="#B71C1C"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>

				<!-- Right Icons / Support -->
				<StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<!--<TextBlock Text="Call for Support 07969 223344"
                               Foreground="White"
                               FontSize="12"/>-->
				</StackPanel>
			</Grid>
		</Border>

		<!-- 🟦 BODY (content region: pages will be loaded inside this ContentControl) -->
		<ContentControl Grid.Row="1"
						x:Name="ContentRegion"
						Margin="20">

			<!-- Default / fallback content (keeps previous layout as the initial page) -->
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Header Row -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock Text="Table View"
                           FontSize="18"
                           FontWeight="SemiBold"/>

					<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            >
						<Button Content="Delivery"
                                Padding="12,6"
                                Background="#C62828"
                                Foreground="White"
                                BorderThickness="0"/>

						<Button Content="Pick Up"
                                Padding="12,6"/>

						<!--<Button Content="Add Table"
                                Padding="12,6"/>-->
					</StackPanel>
				</Grid>

				<!-- Table Grid -->
				<UniformGrid Grid.Row="1"
                         Columns="6"
                         Margin="0,20,0,0">

					<!-- Table Card Template -->
					<Border BorderBrush="#BDBDBD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="10"
                        Height="100">
						<TextBlock Text="Table 1"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Border>

				</UniformGrid>
			</Grid>
		</ContentControl>
	</Grid>
</Window>
