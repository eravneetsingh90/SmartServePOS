<Page
	x:Class="SmartServePOS.Views.CategoryView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	d:DataContext="{d:DesignInstance Type=viewmodels:CategoryViewModel}"
	Background="#F5F5F5"
	mc:Ignorable="d">
	<Grid Margin="16">
		<!--  MAIN CARD  -->
		<Border
			Padding="16"
			Background="White"
			BorderBrush="#E0E0E0"
			BorderThickness="1"
			CornerRadius="8">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  ================= HEADER =================  -->
				<DockPanel Margin="0,0,0,12">

					<TextBlock
						VerticalAlignment="Center"
						DockPanel.Dock="Left"
						FontSize="20"
						FontWeight="SemiBold"
						Text="Categories" />

					<StackPanel
						Margin="10,0,0,0"
						DockPanel.Dock="Right"
						Orientation="Horizontal">

						<Button
							Margin="0,0,8,0"
							Background="#F3F3F3"
							BorderBrush="#CCC"
							Command="{Binding AddCommand}"
							Content="+ Add Category" />
						<Button
							Margin="0,0,8,0"
							Background="#2E7D32"
							Command="{Binding SaveCommand}"
							Content="Save Changes"
							Foreground="White" />
						<Button
							Background="#0047AB"
							Command="{Binding RefreshCommand}"
							Content="Refresh 🔄"
							Foreground="White" />
					</StackPanel>
				</DockPanel>

				<!--  ================= DATAGRID =================  -->
				<DataGrid
					Grid.Row="1"
					AutoGenerateColumns="False"
					Background="White"
					BorderThickness="0"
					CanUserAddRows="False"
					GridLinesVisibility="None"
					HeadersVisibility="Column"
					ItemsSource="{Binding Categories}"
					RowHeight="38"
					SelectionMode="Single">
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="80"
							Binding="{Binding DisplayOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Order">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Center" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="HorizontalContentAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
							Header="Category Name">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,0" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="Padding" Value="8" />
									<Setter Property="BorderBrush" Value="#C62828" />
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>
						<DataGridCheckBoxColumn
							Width="65"
							Binding="{Binding IsStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Is Stock">
							<DataGridCheckBoxColumn.ElementStyle>
								<Style TargetType="CheckBox">
									<Setter Property="HorizontalAlignment" Value="Center" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridCheckBoxColumn.ElementStyle>
						</DataGridCheckBoxColumn>
						<DataGridCheckBoxColumn
							Width="60"
							Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="Active">
							<DataGridCheckBoxColumn.ElementStyle>
								<Style TargetType="CheckBox">
									<Setter Property="HorizontalAlignment" Value="Center" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</DataGridCheckBoxColumn.ElementStyle>
						</DataGridCheckBoxColumn>
						<DataGridTemplateColumn Width="60" Header="Delete">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button
										Background="Transparent"
										BorderThickness="0"
										Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
										CommandParameter="{Binding}"
										Content="✕"
										FontSize="14"
										Foreground="Red"
										ToolTip="Delete Category" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>
	</Grid>
</Page>
