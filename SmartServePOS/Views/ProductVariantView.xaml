<Page x:Class="SmartServePOS.Views.ProductVariantView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:SmartServePOS.ViewModels"
	  d:DataContext="{d:DesignInstance Type=viewmodels:ProductVariantViewModel}"
      mc:Ignorable="d"
      Background="#F5F5F5">

	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ================= CATEGORIES ================= -->
		<Border Grid.Column="0"
				Background="White"
				CornerRadius="6"
				Padding="6"
				Opacity="{Binding IsSearchActive,
                Converter={StaticResource BoolToOpacityConverter}}"
				IsHitTestVisible="{Binding IsSearchActive,
                Converter={StaticResource BoolToHitTestConverter}}">

			<GroupBox Header="Categories"
					  FontSize="14"
					  Background="#262626">
				<ListBox
				ItemsSource="{Binding Categories}"
             SelectedItem="{Binding SelectedCategory}"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.VerticalScrollBarVisibility="Auto">

					<!-- Remove default selection visuals -->
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="2"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Root"
                        Height="46"
                        Background="#333333"
                        CornerRadius="6">

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<!-- Accent Bar -->
									<Border x:Name="Accent"
                                Grid.Column="0"
                                Background="#C62828"
                                CornerRadius="6,0,0,6"
                                Visibility="Collapsed"/>

									<!-- Text -->
									<TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>
								</Grid>
							</Border>

							<!-- STATES -->
							<DataTemplate.Triggers>

								<!-- Selected -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                 Value="True">
									<Setter TargetName="Root" Property="Background" Value="#3E3E3E"/>
									<Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
								</DataTrigger>

								<!-- Hover -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                 Value="True">
									<Setter TargetName="Root" Property="Background" Value="#444444"/>
								</DataTrigger>

							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</GroupBox>
		</Border>


		<!-- ================= PRODUCTS ================= -->
		<Border Grid.Column="1"
        Background="White"
        CornerRadius="8"
        BorderBrush="#F3F4F6"
        BorderThickness="1"
        Padding="12"
        Margin="0,0,12,0">

			<GroupBox Header="Products"
		  FontSize="14"
		  Background="White">
				<ListBox ItemsSource="{Binding Products}"
				SelectedItem="{Binding SelectedProduct}"
				BorderThickness="0"
				Background="Transparent"
				ScrollViewer.VerticalScrollBarVisibility="Auto">

					<!-- Remove default selection visuals -->
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="2"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Root"
						   Height="46"
						   Background="#eaeaea"
						   CornerRadius="6">

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="6"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<!-- Accent Bar -->
									<Border x:Name="Accent"
								   Grid.Column="0"
								   Background="#C62828"
								   CornerRadius="6,0,0,6"
								   Visibility="Collapsed"/>

									<!-- Text -->
									<TextBlock Grid.Column="1"
									  Text="{Binding Name}"
									  FontSize="12"
									  FontWeight="SemiBold"
									  Foreground="Black"
									  VerticalAlignment="Center"
									  Margin="12,0"/>
								</Grid>
							</Border>

							<!-- STATES -->
							<DataTemplate.Triggers>

								<!-- Selected -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
            Value="True">
									<Setter TargetName="Root" Property="Background" Value="#D1D5DB"/>
									<Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
								</DataTrigger>

								<!-- Hover -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
            Value="True">
									<Setter TargetName="Root" Property="Background" Value="#E5E7EB"/>
								</DataTrigger>

							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</GroupBox>
		</Border>

		<!-- ================= VARIANTS ================= -->
		<Border Grid.Column="2" Padding="16" CornerRadius="8"
            Background="White">

			<StackPanel>
				<DockPanel Margin="0,0,0,12">
					<TextBlock Text="{Binding SelectedProduct.Name}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>

					<StackPanel Orientation="Horizontal"
								DockPanel.Dock="Right"
								Margin="10,0,0,0">
						<Button Content="+ Add Variant"
                            Command="{Binding AddVariantCommand}"
                            Margin="0,0,8,0"
							Background="#F3F3F3"
							BorderBrush="#CCC"/>
						<Button Content="Save Changes"
								Background="#2E7D32"
								Foreground="White"
								Command="{Binding SaveCommand}"/>
						<Button Content="Refresh 🔄"
								Background="#0047AB"
								Foreground="White"
								Command="{Binding RefreshCommand}"/>
					</StackPanel>
				</DockPanel>


				<DataGrid Grid.Row="1"
							  ItemsSource="{Binding Variants}"
							  AutoGenerateColumns="False"
							  CanUserAddRows="False"
							  RowHeight="38"
							  HeadersVisibility="Column"
							  GridLinesVisibility="None"
							  BorderThickness="0"
							  Background="White"
							  SelectionMode="Single">
					<!-- HEADER STYLE -->
					<DataGrid.ColumnHeaderStyle>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background" Value="#F7F7F7"/>
							<Setter Property="Foreground" Value="#555"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="Padding" Value="12,8"/>
							<Setter Property="BorderThickness" Value="0,0,0,1"/>
							<Setter Property="BorderBrush" Value="#DDD"/>
						</Style>
					</DataGrid.ColumnHeaderStyle>
					<!-- ROW STYLE -->
					<DataGrid.RowStyle>
						<Style TargetType="DataGridRow">
							<Setter Property="Background" Value="White"/>
							<Setter Property="BorderThickness" Value="0,0,0,1"/>
							<Setter Property="BorderBrush" Value="#EEE"/>

							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#F9F9F9"/>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Background" Value="#FFF3E0"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</DataGrid.RowStyle>
					<DataGrid.Columns>
						<DataGridTextColumn Header="Order"
					Width="80"
					Binding="{Binding DisplayOrder,
					Mode=TwoWay,
				    UpdateSourceTrigger=PropertyChanged}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Center"/>
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="HorizontalContentAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Variant Name"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Width="*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,0"/>
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="Padding" Value="8"/>
									<Setter Property="BorderBrush" Value="#C62828"/>
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Price"
											Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
											Width="120">		
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,0"/>
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.ElementStyle>

							<DataGridTextColumn.EditingElementStyle>
								<Style TargetType="TextBox">
									<Setter Property="Padding" Value="8"/>
									<Setter Property="BorderBrush" Value="#C62828"/>
								</Style>
							</DataGridTextColumn.EditingElementStyle>
						</DataGridTextColumn>


						<!-- ACTIVE -->
						<DataGridCheckBoxColumn Header="Active"
										Binding="{Binding IsActive,
												  Mode=TwoWay,
												  UpdateSourceTrigger=PropertyChanged}"
										Width="60">
							<DataGridCheckBoxColumn.ElementStyle>
								<Style TargetType="CheckBox">
									<Setter Property="HorizontalAlignment" Value="Center"/>
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</DataGridCheckBoxColumn.ElementStyle>
						</DataGridCheckBoxColumn>

						<!-- DELETE -->
						<DataGridTemplateColumn Width="60" Header="Delete">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="✕"
                    Foreground="Red"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    ToolTip="Delete Category"
                    Command="{Binding DataContext.DeleteCommand,
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</StackPanel>
		</Border>
	</Grid>

</Page>
