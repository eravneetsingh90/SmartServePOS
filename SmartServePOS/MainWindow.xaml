<Window
	x:Class="SmartServePOS.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="SmartServe POS"
	Width="1200"
	Height="700"
	Background="#F5F5F5"
	Icon="Assets/Icons/smartserve.ico"
	ResizeMode="CanResize"
	WindowStartupLocation="CenterScreen">

	<!--  ================= RESOURCES =================  -->
	<Window.Resources>

		<!--  Converter: Empty Text → Visibility  -->
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<!--  Watermark TextBox Style  -->
		<Style x:Key="WatermarkTextBox" TargetType="TextBox">
			<Setter Property="BorderBrush" Value="#CCC" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Grid>
							<ScrollViewer x:Name="PART_ContentHost" />

							<TextBlock
								Margin="8,0"
								VerticalAlignment="Center"
								Foreground="#999"
								IsHitTestVisible="False"
								Text="{TemplateBinding Tag}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<!--  ================= LAYOUT =================  -->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="{Binding IsLoggedIn, Converter={StaticResource BoolToGridLengthConverter}}" />
			<!--  HEADER  -->
			<RowDefinition Height="*" />
			<!--  CONTENT  -->
		</Grid.RowDefinitions>

		<!--  ================= HEADER =================  -->
		<Border
			Grid.Row="0"
			Background="White"
			BorderBrush="#E0E0E0"
			BorderThickness="0,0,0,1"
			Visibility="{Binding IsLoggedIn}">

			<DockPanel Margin="8,0">

				<!--  LEFT: MENU + TITLE  -->
				<StackPanel
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					Orientation="Horizontal">

					<Button
						Width="36"
						Height="36"
						Background="Transparent"
						BorderThickness="0"
						Content="☰"
						FontSize="18" />

					<TextBlock
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						FontSize="18"
						FontWeight="Bold"
						Text="SmartServe POS" />
				</StackPanel>

				<!--  CENTER: ACTIONS  -->
				<StackPanel
					Margin="20,0,0,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Orientation="Horizontal">

					<Button
						x:Name="NewOrderButton"
						Margin="0,0,8,0"
						Background="#C62828"
						Click="NewOrderButton_Click"
						Content="New Order"
						Foreground="White" />

					<Button
						x:Name="MenuManagementButton"
						Margin="0,0,8,0"
						Background="#C62828"
						Click="MenuManagementButton_Click"
						Content="Menu Management"
						Foreground="White" />

					<Button
						x:Name="StockManagementButton"
						Margin="0,0,8,0"
						Background="#C62828"
						Click="StockManagementButton_Click"
						Content="Stock Management"
						Foreground="White" />

				</StackPanel>
			</DockPanel>
		</Border>

		<!--  ================= MAIN CONTENT =================  -->
		<Frame
			x:Name="MainFrame"
			Grid.Row="1"
			Background="#F5F5F5"
			NavigationUIVisibility="Hidden" />
	</Grid>
</Window>
